<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PSClassicsfPKGBuilder.Controls.DashPreview">

    <!-- Approximation of the PS4 / PS5 home screen, same layout as the Windows app: everything is drawn on a 1920x1080
         canvas scaled by the Viewbox. Images are stretched like the build does (icon0 512x512, background 1920x1080). -->
    <Border CornerRadius="8" ClipToBounds="True" Background="#0B0F1A">
        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080" ClipToBounds="True">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1B2A4A" Offset="0" />
                        <GradientStop Color="#0B0F1A" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Image x:Name="BackgroundImage" Stretch="Fill" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#99000000" Offset="0" />
                            <GradientStop Color="#22000000" Offset="0.55" />
                            <GradientStop Color="#AA000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- PS4 home screen -->
                <Canvas x:Name="PS4Layout">
                    <TextBlock Canvas.Left="1640" Canvas.Top="40" Text="12:00" FontSize="44" Foreground="White" Opacity="0.85" />
                    <Border Canvas.Left="90" Canvas.Top="260" Width="220" Height="220" Background="#33FFFFFF" />
                    <Border Canvas.Left="330" Canvas.Top="200" Width="340" Height="340" BorderBrush="White" BorderThickness="6" Background="#22FFFFFF">
                        <Grid>
                            <TextBlock x:Name="PS4IconPlaceholder" Text="icon0" FontSize="56" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="PS4IconImage" Stretch="Fill" />
                        </Grid>
                    </Border>
                    <Border Canvas.Left="690" Canvas.Top="260" Width="220" Height="220" Background="#33FFFFFF" />
                    <Border Canvas.Left="930" Canvas.Top="260" Width="220" Height="220" Background="#26FFFFFF" />
                    <Border Canvas.Left="1170" Canvas.Top="260" Width="220" Height="220" Background="#1FFFFFFF" />
                    <Border Canvas.Left="1410" Canvas.Top="260" Width="220" Height="220" Background="#14FFFFFF" />
                    <TextBlock x:Name="PS4TitleText" Canvas.Left="330" Canvas.Top="570" Width="1300" FontSize="64" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <Border Canvas.Left="330" Canvas.Top="670" CornerRadius="6" Background="#E6FFFFFF" Padding="40,12">
                        <TextBlock Text="Start" FontSize="44" Foreground="#111111" />
                    </Border>
                </Canvas>

                <!-- PS5 home screen -->
                <Canvas x:Name="PS5Layout" IsVisible="False">
                    <TextBlock Canvas.Left="90" Canvas.Top="50" Text="Games" FontSize="44" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Canvas.Left="270" Canvas.Top="50" Text="Media" FontSize="44" Foreground="White" Opacity="0.6" />
                    <TextBlock Canvas.Left="1640" Canvas.Top="50" Text="12:00" FontSize="44" Foreground="White" Opacity="0.85" />
                    <Border Canvas.Left="90" Canvas.Top="150" Width="240" Height="240" CornerRadius="28" BorderBrush="White" BorderThickness="6" Background="#22FFFFFF" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PS5IconPlaceholder" Text="icon0" FontSize="48" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="PS5IconImage" Stretch="Fill" />
                        </Grid>
                    </Border>
                    <Border Canvas.Left="360" Canvas.Top="190" Width="160" Height="160" CornerRadius="22" Background="#33FFFFFF" />
                    <Border Canvas.Left="540" Canvas.Top="190" Width="160" Height="160" CornerRadius="22" Background="#2BFFFFFF" />
                    <Border Canvas.Left="720" Canvas.Top="190" Width="160" Height="160" CornerRadius="22" Background="#22FFFFFF" />
                    <Border Canvas.Left="900" Canvas.Top="190" Width="160" Height="160" CornerRadius="22" Background="#1AFFFFFF" />
                    <Border Canvas.Left="1080" Canvas.Top="190" Width="160" Height="160" CornerRadius="22" Background="#12FFFFFF" />
                    <TextBlock x:Name="PS5TitleText" Canvas.Left="90" Canvas.Top="560" Width="1700" FontSize="96" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <Border Canvas.Left="90" Canvas.Top="720" CornerRadius="40" Background="White" Padding="90,18">
                        <TextBlock Text="Play" FontSize="48" FontWeight="SemiBold" Foreground="#111111" />
                    </Border>
                </Canvas>
            </Grid>
        </Viewbox>
    </Border>
</UserControl>
