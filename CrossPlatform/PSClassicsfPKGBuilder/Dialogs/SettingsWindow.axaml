<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PSClassicsfPKGBuilder.Dialogs.SettingsWindow"
        Title="Settings - PS Classics fPKG Builder" Width="600" Height="540" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <StackPanel Grid.Row="0">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="LanguageComboBox" Width="260" />
            <TextBlock Text="The whole app changes language at once." FontSize="12" Margin="0,4,0,18" Foreground="{DynamicResource SecondaryTextBrush}" />

            <CheckBox x:Name="GuidedModeCheckBox" Content="Step-by-step mode" />
            <TextBlock Text="Shows one step at a time (Game, Images, Options, Review) with Next and Back buttons. Recommended for beginners." TextWrapping="Wrap" FontSize="12" Margin="28,0,0,14" Foreground="{DynamicResource SecondaryTextBrush}" />

            <CheckBox x:Name="CheckPackageCheckBox" Content="Check the package after building" />
            <TextBlock Text="Runs a quick check of every new package and tells you if something is wrong." TextWrapping="Wrap" FontSize="12" Margin="28,0,0,14" Foreground="{DynamicResource SecondaryTextBrush}" />

            <CheckBox x:Name="CheckUpdatesCheckBox" Content="Check for new versions" />
            <TextBlock Text="Once a day the app asks GitHub for the latest version number. Nothing else is sent." TextWrapping="Wrap" FontSize="12" Margin="28,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <Button Grid.Row="1" x:Name="CloseButton" Content="Close" Classes="accent" MinWidth="90" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
