<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="PSClassicsfPKGBuilder.Dialogs.BuildResultWindow"
        Title="Build result - PS Classics fPKG Builder" Width="760" Height="600" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <mi:MaterialIcon x:Name="ResultIcon" Kind="CheckCircle" Width="36" Height="36" />
                <TextBlock x:Name="ResultTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock x:Name="SuggestionText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#FFC857" />
            <TextBlock x:Name="PackageText" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <DockPanel Grid.Row="1" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" x:Name="DetailsHeader" Text="Details" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="DetailsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" />
        </DockPanel>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Content="Copy" Margin="0,0,8,8" />
            <Button x:Name="FullCheckButton" Content="Full check" Margin="0,0,8,8"
                    ToolTip.Tip="Runs the SDK checker on the package (can take minutes on large games)" />
            <Button x:Name="InstallGuideButton" Content="How to install" Margin="0,0,8,8" />
            <Button x:Name="OpenFolderButton" Content="Open folder" Margin="0,0,8,8" />
            <Button x:Name="CloseButton" Content="Close" Classes="accent" MinWidth="90" IsDefault="True" IsCancel="True" Margin="0,0,0,8" />
        </WrapPanel>
    </Grid>
</Window>
