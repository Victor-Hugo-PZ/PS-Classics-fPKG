<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PSClassicsfPKGBuilder.Dialogs.GuideWindow"
        Title="Guide - PS Classics fPKG Builder" Width="760" Height="720" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.bullet">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,0,0,4" />
        </Style>
    </Window.Styles>

    <ScrollViewer Padding="28,16,28,28">
        <StackPanel>
            <TextBlock Text="How to create a fPKG" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Classes="body" Margin="0,4,0,0"
                       Text="Pick a platform on the left, fill the fields and press Build fPKG. Every field has a help button (i) that explains it." />

            <TextBlock Text="1. Quick start" Classes="heading" />
            <TextBlock Classes="bullet" Text="• Select Disc 1 (the BIN file for PS1, the ISO for PS2 and PSP). The game ID and the title are filled in when the game is recognized." />
            <TextBlock Classes="bullet" Text="• Check the NP Title: it must have exactly 9 characters, without _ or -." />
            <TextBlock Classes="bullet" Text="• Optional: choose an icon and a background." />
            <TextBlock Classes="bullet" Text="• Press Build fPKG and choose the output folder. The package is created there." />

            <TextBlock Text="2. Required and optional fields" Classes="heading" />
            <TextBlock Classes="body" Text="Fields marked Required must be filled, or the build stops with a message. Fields marked Optional can be left empty." />
            <TextBlock Classes="bullet" Text="• PS1: Disc 1, Title, NP Title. Optional: icon, background, discs 2 to 4, emulator options, TXT and LUA configs." />
            <TextBlock Classes="bullet" Text="• PS2: Disc 1, Title, NP Title. Optional: icon, background, discs 2 to 5, emulator options, database configs, your own TXT or LUA config, memory card." />
            <TextBlock Classes="bullet" Text="• PSP: ISO file, Title, NP Title. Optional: icon, background, custom config." />

            <TextBlock Text="3. Images (icon and background)" Classes="heading" />
            <TextBlock Classes="body" Text="You do not need to convert images first. The app accepts PNG, JPG, BMP, GIF and WebP and converts them to PNG:" />
            <TextBlock Classes="bullet" Text="• Icon: 512×512 pixels. A square image avoids distortion." />
            <TextBlock Classes="bullet" Text="• Background: 1920×1080 pixels. A 16:9 image avoids distortion." />
            <TextBlock Classes="bullet" Text="• The preview on the right shows what the home screen will look like and warns when an image will be stretched or enlarged. For animated GIFs only the first frame is used." />

                <TextBlock Text="4. Emulators" Classes="heading" />
                <TextBlock Classes="bullet" Text="• PS1: the emulator is fixed (ps1hd). The options only change how it runs." />
                <TextBlock Classes="bullet" Text="• PS2: choose between Jak v2 (the default) and Rogue v1. If a game does not start or crashes, try the other one." />
                <TextBlock Classes="bullet" Text="• PSP: the emulator is fixed (psphd)." />
                <TextBlock Classes="body" Margin="0,6,0,0" Text="The options under the emulator (upscaling, uprender, display mode, fixes) are optional. Start with the defaults; change one option at a time if a game has problems." />

                <TextBlock Text="5. Helpers that save time" Classes="heading" />
                <TextBlock Classes="bullet" Text="• Drag and drop: drop the game (.bin, .cue or .iso), images, configs or a .pkg anywhere on the window. A .zip or .7z is opened by itself: the game files inside are found. The app puts each file in the right field." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Queue: the Queue button builds several games from .zip or .7z files, one after the other, with no questions. Choose the output folder and a preset, then press Start." />
                <TextBlock Style="{StaticResource Bullet}" Text="• PSP games in .cso (compressed) are accepted: the app converts them to .iso by itself." />
                <TextBlock Style="{StaticResource Bullet}" Text="• When something goes wrong, the message can have a Fix button (select the game again, show the Tools folder, clear the images...) that does it for you." />
                <TextBlock Classes="bullet" Text="• Find cover (PS1 and PS2): downloads the cover of the game by its ID and creates the icon and the background. PSP: 'Images from the disc' uses the icon and background stored on the disc." />
                <TextBlock Classes="bullet" Text="• Presets: in the Emulator section, choose Recommended, Most compatible or Best looking instead of changing each option." />
                <TextBlock Classes="bullet" Text="• Step-by-step mode (Settings): shows one step at a time with Next and Back buttons." />
                <TextBlock Classes="bullet" Text="• Before building, the app checks the files, the NP title and the free disk space, and tells you how to fix each problem." />
                <TextBlock Classes="bullet" Text="• After building, the package is checked automatically and the History keeps the options you used, so you can compare what works." />

                <TextBlock x:Name="InstallSection" Text="6. Install the package on the console" Classes="heading" />
                <TextBlock Classes="body" Text="Fake packages only install on a console with homebrew enabled (a jailbroken PS4 or PS5). The app cannot do that part for you." />
                <TextBlock Classes="bullet" Text="1. Copy the .pkg file to the root folder of a USB drive formatted as exFAT (FAT32 also works for packages smaller than 4 GB)." />
                <TextBlock Classes="bullet" Text="2. PS4 with GoldHEN: plug in the drive, open Settings › Debug Settings › Game › Package Installer, choose the package and install it." />
                <TextBlock Classes="bullet" Text="3. PS5 with etaHEN: install the package from the USB drive with the package installer of your homebrew (for example the etaHEN debug settings or ItemzFlow)." />
                <TextBlock Classes="bullet" Text="4. The game appears on the home screen with the icon you chose. If it does not start, write what happened in the History and try another emulator preset." />
                <TextBlock Classes="body" Margin="0,6,0,0" Text="You can also send the package over the network with a remote package installer; see the documentation of your homebrew." />

                <TextBlock Text="7. Wine (Linux and macOS)" Classes="heading" />
                <TextBlock Classes="body" Text="The PS4 publishing tools are Windows programs: on Linux and macOS the app runs them through Wine. Install Wine and winetricks once, then press 'Wine setup' in the app: it prepares a Wine folder for the app and installs the Visual C++ 2008 runtime the tools need. The status at the bottom left tells you when everything is ready." />

                <TextBlock Text="8. Problems?" Classes="heading" />
                <TextBlock Classes="bullet" Text="• A yellow warning under the preview is about an image, not an error: it is only a suggestion." />
                <TextBlock Classes="bullet" Text="• If the app says the Tools folder is missing, keep the Tools folder next to the program (see the README)." />
                <TextBlock Classes="bullet" Text="• Use 'Check a .pkg' to verify a package you created." />
                <TextBlock Classes="bullet" Text="• If a game does not work on the console, note the emulator and the options you used and try changing one option at a time." />
        </StackPanel>
    </ScrollViewer>
</Window>
