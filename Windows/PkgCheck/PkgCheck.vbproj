<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PkgCheck</RootNamespace>
    <AssemblyName>PkgCheck</AssemblyName>
    <Version>1.1.0</Version>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>$(NoWarn);41999;42016;42017;42018;42019;42020;42021;42022;42032;42036;42314</NoWarn>
  </PropertyGroup>

  <!-- The checker lives in the shared Core library, like in the apps (Windows, Linux, macOS). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\PSClassics.Core\PSClassics.Core.vbproj" />
  </ItemGroup>

</Project>
