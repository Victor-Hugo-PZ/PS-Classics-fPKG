<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PkgCheck</RootNamespace>
    <AssemblyName>PkgCheck</AssemblyName>
    <Version>1.0.0</Version>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);41999;42016;42017;42018;42019;42020;42021;42022;42032;42036;42314</NoWarn>
  </PropertyGroup>

  <!-- The checker is shared with the app: the same source files are compiled here. -->
  <ItemGroup>
    <Compile Include="Program.vb" />
    <Compile Include="..\PS Classics fPKG Builder\AppPaths.vb" Link="Shared\AppPaths.vb" />
    <Compile Include="..\PS Classics fPKG Builder\Core\ProcessRunner.vb" Link="Shared\ProcessRunner.vb" />
    <Compile Include="..\PS Classics fPKG Builder\Core\PackageVerifier.vb" Link="Shared\PackageVerifier.vb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\LibOrbisPkg\LibOrbisPkg\LibOrbisPkg.csproj" />
  </ItemGroup>

</Project>
