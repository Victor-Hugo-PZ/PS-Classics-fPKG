<ui:FluentWindow x:Class="HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="History - PS Classics fPKG Builder" Width="1000" Height="680" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="History" />

        <TextBlock Grid.Row="1" Margin="24,0,24,12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Every package you build is listed here with the options you used. Write down how each one runs on the console to compare emulator settings." />

        <Grid Grid.Row="2" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="No packages built yet." Margin="0,8" Visibility="Collapsed" />
                <ListBox x:Name="EntriesListBox" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailsPanel" IsEnabled="False">
                    <TextBlock x:Name="DetailsTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailsInfo" TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Options used" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailsSettings" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,16" />
                    <TextBlock Text="How did it run on the console?" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="ConsoleResultComboBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ui:TextBox x:Name="NotesTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalContentAlignment="Top"
                                PlaceholderText="For example: crashes after the menu, works with Rogue v1" />
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button x:Name="SaveButton" Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Margin="0,0,8,8" />
                        <ui:Button x:Name="OpenFolderButton" Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,8" />
                        <ui:Button x:Name="DeleteButton" Content="Remove from history" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
