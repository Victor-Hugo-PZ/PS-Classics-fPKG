<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PS_Classics_fPKG_Builder</RootNamespace>
    <AssemblyName>PS Classics fPKG Builder</AssemblyName>
    <StartupObject>PS_Classics_fPKG_Builder.Application</StartupObject>
    <ApplicationIcon>v14Icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <NoWarn>$(NoWarn);41999;42016;42017;42018;42019;42020;42021;42022;42032;42036;42314</NoWarn>
    <!-- Sources are listed explicitly (VB globbing would also pick up the legacy "My Project" folder). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.vb" Exclude="obj\**;bin\**" />
    <Page Include="PSClassicsfPKGBuilder.xaml" />
    <ApplicationDefinition Include="Application.xaml" />
    <Resource Include="v14Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Linq" />
    <Import Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiscUtils.Core" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Iso9660" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Streams" Version="0.16.13" />
    <PackageReference Include="DiscUtils.Udf" Version="0.16.13" />
  </ItemGroup>

  <!-- LibOrbisPkg (LGPL-3.0, https://github.com/OpenOrbis/LibOrbisPkg) is built from source: it is a git submodule in external/LibOrbisPkg.
       Clone with the recurse-submodules option of git clone, or run: git submodule update, with the init option -->

  <PropertyGroup>
    <LibOrbisPkgProject>$(MSBuildThisFileDirectory)..\..\external\LibOrbisPkg\LibOrbisPkg\LibOrbisPkg.csproj</LibOrbisPkgProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LibOrbisPkgProject)" />
  </ItemGroup>
  <Target Name="CheckLibOrbisPkg" BeforeTargets="ResolveProjectReferences;_CheckForInvalidConfigurationAndPlatform">
    <Error Condition="!Exists('$(LibOrbisPkgProject)')" Text="The LibOrbisPkg submodule is missing. Run: git submodule update --init" />
  </Target>

  <!-- Third-party tools and emulators (not part of the repository, git-ignored) are copied next to the executable when present. -->
  <PropertyGroup>
    <ToolsSourceDir>$(MSBuildThisFileDirectory)..\..\Tools\</ToolsSourceDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ToolsSourceDir)') And '$(CopyToolsToOutput)' != 'false'">
    <None Include="$(ToolsSourceDir)**\*" Link="Tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
