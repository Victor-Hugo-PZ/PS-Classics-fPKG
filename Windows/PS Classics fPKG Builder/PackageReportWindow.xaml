<ui:FluentWindow x:Class="PackageReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Package check - PS Classics fPKG Builder" Width="820" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Package check" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon x:Name="ResultIcon" FontSize="28" Margin="0,0,10,0" />
                <TextBlock x:Name="ResultTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ResultSubtitle" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ui:TextBox Grid.Row="2" x:Name="ReportTextBox" Margin="24,0,24,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Top" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <ui:Button x:Name="CopyButton" Content="Copy report" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" />
            <ui:Button x:Name="ToolOutputButton" Content="Show tool output" Icon="{ui:SymbolIcon Document24}" Margin="0,0,8,0" />
            <ui:Button x:Name="CloseButton" Content="Close" Appearance="Primary" IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
