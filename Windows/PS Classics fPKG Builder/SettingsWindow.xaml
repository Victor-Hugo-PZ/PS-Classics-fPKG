<ui:FluentWindow x:Class="SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings - PS Classics fPKG Builder" Width="600" Height="520" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="LanguageComboBox" Width="260" HorizontalAlignment="Left" />
            <TextBlock Text="The whole app changes language at once." FontSize="12" Margin="0,4,0,18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <CheckBox x:Name="GuidedModeCheckBox" Content="Step-by-step mode" />
            <TextBlock Text="Shows one step at a time (Game, Images, Options, Review) with Next and Back buttons. Recommended for beginners." TextWrapping="Wrap" FontSize="12" Margin="28,0,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <CheckBox x:Name="CheckPackageCheckBox" Content="Check the package after building" />
            <TextBlock Text="Runs a quick check of every new package and tells you if something is wrong." TextWrapping="Wrap" FontSize="12" Margin="28,0,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <CheckBox x:Name="CheckUpdatesCheckBox" Content="Check for new versions" />
            <TextBlock Text="Once a day the app asks GitHub for the latest version number. Nothing else is sent." TextWrapping="Wrap" FontSize="12" Margin="28,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <ui:Button x:Name="CloseButton" Content="Close" Appearance="Primary" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
