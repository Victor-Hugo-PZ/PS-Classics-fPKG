Imports System.Drawing.Imaging
Imports System.IO

''' <summary>Result of a package build.</summary>
Public Class PackageBuildResult
    Public Property Success As Boolean
    ''' <summary>Output of the PS4 publishing tool (useful to show the reason of a failure).</summary>
    Public Property Output As String = ""
End Class

''' <summary>Image and folder helpers shared by the package builders.</summary>
Friend Class BuilderHelpers

    ''' <summary>Saves a user selected image as a 24 bpp PNG with the size expected by the PS4 (icon0.png, pic0.png).</summary>
    Friend Shared Sub SavePNG(SourceImageFile As String, DestinationFile As String, Width As Integer, Height As Integer)
        Using NewFileStream As New FileStream(SourceImageFile, FileMode.Open, FileAccess.Read)
            Using SourceImage As System.Drawing.Image = System.Drawing.Image.FromStream(NewFileStream)
                Using ResizedImage As System.Drawing.Image = Utils.ResizeAsImage(SourceImage, Width, Height)
                    Using ConvertedImage As System.Drawing.Bitmap = Utils.ConvertTo24bppPNG(ResizedImage)
                        ConvertedImage.Save(DestinationFile, ImageFormat.Png)
                    End Using
                End Using
            End Using
        End Using
    End Sub

    ''' <summary>Copies the selected icon and background to the sce_sys folder of the cache directory.</summary>
    Friend Shared Sub AddIconAndBackground(GameCacheDirectory As String, IconFile As String, BackgroundFile As String)
        Directory.CreateDirectory(GameCacheDirectory + "\sce_sys")
        If Not String.IsNullOrEmpty(IconFile) Then
            SavePNG(IconFile, GameCacheDirectory + "\sce_sys\icon0.png", 512, 512)
        End If
        If Not String.IsNullOrEmpty(BackgroundFile) Then
            SavePNG(BackgroundFile, GameCacheDirectory + "\sce_sys\pic0.png", 1920, 1080)
        End If
    End Sub

    ''' <summary>Generates the GP4 project, throwing when the generator did not produce it.</summary>
    Friend Shared Sub GenerateGp4(GameCacheDirectory As String, Gp4File As String)
        PkgTools.GenerateGp4(GameCacheDirectory)
        If Not File.Exists(Gp4File) Then
            Throw New FileNotFoundException("The GP4 project was not generated by gengp4_patch.exe.", Gp4File)
        End If
    End Sub

    Friend Shared Function CreatePackage(Gp4File As String, OutputFolder As String) As PackageBuildResult
        Dim BuildResult As ProcessResult = PkgTools.CreatePKG(Gp4File, OutputFolder)
        Return New PackageBuildResult With {.Success = PkgTools.IsSuccessful(BuildResult.Output), .Output = BuildResult.Output + BuildResult.ErrorOutput}
    End Function

End Class

#Region "PS1"

Public Class PS1BuildRequest
    Public Property Title As String = ""
    ''' <summary>The 9 character NP title, for example "SLUS00594".</summary>
    Public Property NPTitle As String = ""
    ''' <summary>The detected game ID ("SLUS-00594"), or empty.</summary>
    Public Property DetectedGameID As String = ""
    Public Property Disc1 As String = ""
    Public Property Disc2 As String = ""
    Public Property Disc3 As String = ""
    Public Property Disc4 As String = ""
    Public Property IconFile As String = ""
    Public Property BackgroundFile As String = ""
    Public Property TxtConfigFile As String = ""
    Public Property LuaConfigFile As String = ""
    Public Property Upscaling As String = "2"
    Public Property SkipBootlogo As Boolean
    Public Property Guncon As Boolean
    Public Property Force60Hz As Boolean
    Public Property EmulateAnalogSticks As Boolean
    ''' <summary>Called when the game is libcrypt protected. Returns True to add the libcrypt patch to the configuration. Without a callback the patch is not added.</summary>
    Public Property ConfirmLibcrypt As Func(Of Boolean)
End Class

Public Class PS1PackageBuilder

    Public Shared Function Build(Request As PS1BuildRequest, PKGOutputFolder As String) As PackageBuildResult
        Dim GameCacheDirectory As String = AppPaths.CacheDirectory + "\PS1fPKG"
        Dim Gp4File As String = AppPaths.CacheDirectory + "\PS1fPKG.gp4"

        'Remove previous fPKG creation & re-create the PS1fPKG cache folder
        PkgTools.PrepareCacheDirectory(GameCacheDirectory, Gp4File)

        'Copy the PS1 emulator, the selected icon and background to the cache directory
        FileUtils.CopyDirectory(AppPaths.ToolsDirectory + "\PS4\emus\ps1hd", GameCacheDirectory, True)
        BuilderHelpers.AddIconAndBackground(GameCacheDirectory, Request.IconFile, Request.BackgroundFile)

        'Selected discs (number, BIN file) and their CUE files
        Dim DiscFiles As New List(Of KeyValuePair(Of Integer, String))
        DiscFiles.Add(New KeyValuePair(Of Integer, String)(1, Request.Disc1))
        If Not String.IsNullOrEmpty(Request.Disc2) Then DiscFiles.Add(New KeyValuePair(Of Integer, String)(2, Request.Disc2))
        If Not String.IsNullOrEmpty(Request.Disc3) Then DiscFiles.Add(New KeyValuePair(Of Integer, String)(3, Request.Disc3))
        If Not String.IsNullOrEmpty(Request.Disc4) Then DiscFiles.Add(New KeyValuePair(Of Integer, String)(4, Request.Disc4))
        Dim Disc1CueFile As String = Path.ChangeExtension(Request.Disc1, ".cue")

        'PS1 Emulator configuration
        Dim ConfigOptions As New PS1ConfigOptions() With {
            .DiscNumbers = DiscFiles.Select(Function(Disc) Disc.Key).ToList(),
            .NPTitle = Request.NPTitle,
            .Upscaling = Request.Upscaling,
            .SkipBootlogo = Request.SkipBootlogo,
            .Guncon = Request.Guncon,
            .Force60Hz = Request.Force60Hz,
            .EmulateAnalogSticks = Request.EmulateAnalogSticks
        }

        'Check for libcrypt protection
        Dim ProtectionValue As String = PS1Game.IsGameProtected(PS1Game.FormatLibcryptID(Request.DetectedGameID, Request.NPTitle))
        If Not String.IsNullOrEmpty(ProtectionValue) AndAlso Request.ConfirmLibcrypt IsNot Nothing AndAlso Request.ConfirmLibcrypt.Invoke() Then
            ConfigOptions.LibcryptValue = ProtectionValue
        End If

        'Check for LUA config
        If Not String.IsNullOrEmpty(Request.LuaConfigFile) Then
            ConfigOptions.UseLuaConfig = True
            Directory.CreateDirectory(GameCacheDirectory + "\scripts")
            File.Copy(Request.LuaConfigFile, GameCacheDirectory + "\scripts\" + Request.NPTitle + ".lua", True)
        End If

        'Check for TXT config
        If Not String.IsNullOrEmpty(Request.TxtConfigFile) Then
            ConfigOptions.UserConfigText = File.ReadAllText(Request.TxtConfigFile)
        End If

        File.WriteAllText(GameCacheDirectory + "\config-title.txt", EmulatorConfigs.BuildPS1(ConfigOptions))

        'Create a new PARAM.SFO file
        File.WriteAllBytes(GameCacheDirectory + "\sce_sys\param.sfo", SfoBuilder.Build(SfoBuilder.PS1ContentID(Request.NPTitle), Request.Title, Request.NPTitle))

        'Create TOC file
        ProcessRunner.Run(AppPaths.ToolsDirectory + "\cue2toc.exe", """" + Disc1CueFile + """", Path.GetDirectoryName(Disc1CueFile))

        Dim TocFile As String = Path.Combine(Path.GetDirectoryName(Request.Disc1), Path.GetFileNameWithoutExtension(Request.Disc1) + ".toc")
        If Not File.Exists(TocFile) Then
            Throw New FileNotFoundException("The TOC file could not be created. Make sure a CUE file with the same name as the BIN file exists next to it.", TocFile)
        End If
        Directory.CreateDirectory(GameCacheDirectory + "\data")
        File.Move(TocFile, GameCacheDirectory + "\data\disc1.toc", True)

        'Generate the GP4 project, modify it and add the disc info
        BuilderHelpers.GenerateGp4(GameCacheDirectory, Gp4File)
        Dim Gp4Entries As New List(Of Gp4FileEntry)
        For Each Disc As KeyValuePair(Of Integer, String) In DiscFiles
            Gp4Entries.Add(New Gp4FileEntry("data/disc" + Disc.Key.ToString() + ".cue", Path.ChangeExtension(Disc.Value, ".cue"), True))
            Gp4Entries.Add(New Gp4FileEntry("data/disc" + Disc.Key.ToString() + ".bin", Disc.Value, True))
        Next
        Gp4Editor.PatchFile(Gp4File, Gp4Entries)

        'Create the fPKG
        Return BuilderHelpers.CreatePackage(Gp4File, PKGOutputFolder)
    End Function

End Class

#End Region

#Region "PS2"

Public Class PS2BuildRequest
    Public Property Title As String = ""
    Public Property NPTitle As String = ""
    ''' <summary>The game ID as detected in the ISO ("SLUS_212.58").</summary>
    Public Property DetectedGameID As String = ""
    Public Property GameCRC As String = ""
    Public Property Disc1 As String = ""
    Public Property Disc2 As String = ""
    Public Property Disc3 As String = ""
    Public Property Disc4 As String = ""
    Public Property Disc5 As String = ""
    ''' <summary>Name of the emulator folder in Tools\PS4\emus.</summary>
    Public Property Emulator As String = ""
    Public Property IconFile As String = ""
    Public Property BackgroundFile As String = ""
    Public Property MemoryCardFile As String = ""
    Public Property TxtConfigFile As String = ""
    Public Property LuaConfigFile As String = ""
    Public Property AddTxtConfigFromDatabase As Boolean
    Public Property AddLuaConfigFromDatabase As Boolean
    Public Property AddPS3ConfigFromDatabase As Boolean
    Public Property UseWidescreenPatch As Boolean
    Public Property Uprender As String = ""
    Public Property Upscaling As String = ""
    Public Property DisplayMode As String = ""
    Public Property RestartEmulatorOnDiscChange As Boolean = True
    Public Property MultitapIndex As Integer
    Public Property ImproveSpeed As Boolean
    Public Property FixGraphics As Boolean
    Public Property DisableMTVU As Boolean
    Public Property DisableInstantVIF1Transfer As Boolean
    Public Property UseCompression As Boolean
End Class

Public Class PS2PackageBuilder

    Public Shared Function Build(Request As PS2BuildRequest, PKGOutputFolder As String) As PackageBuildResult
        Dim FullPS2GameID As String = Request.DetectedGameID.Replace(".", "").Replace("_", "-").Trim()
        Dim GameCacheDirectory As String = AppPaths.CacheDirectory + "\PS2fPKG"
        Dim Gp4File As String = AppPaths.CacheDirectory + "\PS2fPKG.gp4"
        Dim ConfigsDirectory As String = AppPaths.ToolsDirectory + "\PS4\ps2-configs"
        Dim PatchesDirectory As String = GameCacheDirectory + "\patches\" + FullPS2GameID

        'Selected discs (slot number, ISO file)
        Dim DiscFiles As New List(Of KeyValuePair(Of Integer, String))
        Dim DiscValues As String() = New String() {Request.Disc1, Request.Disc2, Request.Disc3, Request.Disc4, Request.Disc5}
        For DiscIndex As Integer = 0 To DiscValues.Length - 1
            If Not String.IsNullOrEmpty(DiscValues(DiscIndex)) Then
                DiscFiles.Add(New KeyValuePair(Of Integer, String)(DiscIndex + 1, DiscValues(DiscIndex)))
            End If
        Next

        'Remove previous fPKG creation & re-create the PS2fPKG cache folder
        PkgTools.PrepareCacheDirectory(GameCacheDirectory, Gp4File)

        'Copy the selected PS2 emulator, the selected icon and background to the cache directory
        FileUtils.CopyDirectory(AppPaths.ToolsDirectory + "\PS4\emus\" + Request.Emulator, GameCacheDirectory, True)
        BuilderHelpers.AddIconAndBackground(GameCacheDirectory, Request.IconFile, Request.BackgroundFile)

        'Create a new PARAM.SFO file
        File.WriteAllBytes(GameCacheDirectory + "\sce_sys\param.sfo", SfoBuilder.Build(SfoBuilder.PS2ContentID(Request.NPTitle, Request.DetectedGameID), Request.Title, Request.NPTitle, True))

        'Create a new PS2 emulator configuration file
        Dim ConfigOptions As New PS2ConfigOptions() With {
            .GameID = FullPS2GameID,
            .RawGameID = Request.DetectedGameID,
            .DiscCount = DiscFiles.Count,
            .Uprender = Request.Uprender,
            .Upscaling = Request.Upscaling,
            .DisplayMode = Request.DisplayMode,
            .RestartEmulatorOnDiscChange = Request.RestartEmulatorOnDiscChange,
            .MultitapIndex = Request.MultitapIndex,
            .ImproveSpeed = Request.ImproveSpeed,
            .FixGraphics = Request.FixGraphics,
            .DisableMTVU = Request.DisableMTVU,
            .DisableInstantVIF1Transfer = Request.DisableInstantVIF1Transfer
        }

        'Check for PS3 config file
        If Request.AddPS3ConfigFromDatabase Then
            If File.Exists(ConfigsDirectory + "\ps3\" + Request.DetectedGameID + ".CONFIG") Then
                ConfigOptions.UsePS3Config = True
                Directory.CreateDirectory(PatchesDirectory)
                File.Copy(ConfigsDirectory + "\ps3\" + Request.DetectedGameID + ".CONFIG", PatchesDirectory + "\" + FullPS2GameID + "_lopnor.cfgbin", True)
            ElseIf IsoTools.IsConfigAvailable(Request.DetectedGameID + ".CONFIG", ConfigsDirectory + "\configs_ps3.dat") Then
                ConfigOptions.UsePS3Config = True
                Directory.CreateDirectory(PatchesDirectory)
                IsoTools.ExtractFileFromISO(ConfigsDirectory + "\configs_ps3.dat", Request.DetectedGameID + ".CONFIG", PatchesDirectory + "\" + FullPS2GameID + "_lopnor.cfgbin")
            End If
        End If

        'Widescreen Patch config
        If Request.UseWidescreenPatch Then
            Dim WidescreenPatch As String = ""

            If File.Exists(ConfigsDirectory + "\widescreen\" + Request.GameCRC + ".lua") Then
                WidescreenPatch = File.ReadAllText(ConfigsDirectory + "\widescreen\" + Request.GameCRC + ".lua")
            ElseIf IsoTools.IsConfigAvailable(Request.GameCRC + ".lua", ConfigsDirectory + "\widescreen.dat") Then
                WidescreenPatch = IsoTools.GetPNACHFromDAT(ConfigsDirectory + "\widescreen.dat", Request.GameCRC + ".lua")
            End If

            If Not String.IsNullOrEmpty(WidescreenPatch) Then
                ConfigOptions.UseWidescreenPatch = True
                Directory.CreateDirectory(GameCacheDirectory + "\trophy_data")
                File.WriteAllText(GameCacheDirectory + "\trophy_data\" + FullPS2GameID + "_trophies.lua", WidescreenPatch)
            End If
        End If

        'Copy lua_include to cache directory
        FileUtils.CopyDirectory(AppPaths.ToolsDirectory + "\PS4\lua_include", GameCacheDirectory + "\lua_include", True)

        'Check for LUA config
        If Not String.IsNullOrEmpty(Request.LuaConfigFile) Then
            ConfigOptions.UsePatchesPath = True
            Directory.CreateDirectory(PatchesDirectory)
            File.Copy(Request.LuaConfigFile, GameCacheDirectory + "\patches\" + FullPS2GameID + "_config.lua", True)
        ElseIf Request.AddLuaConfigFromDatabase Then
            If IsoTools.IsConfigAvailable(Request.DetectedGameID, ConfigsDirectory + "\configs_lua.dat") Then
                ConfigOptions.UsePatchesPath = True
                Directory.CreateDirectory(PatchesDirectory)
                IsoTools.ExtractFileFromISO(ConfigsDirectory + "\configs_lua.dat", Request.DetectedGameID, GameCacheDirectory + "\patches\" + FullPS2GameID + "_config.lua")
            End If
        End If

        'Check for TXT config
        If Not String.IsNullOrEmpty(Request.TxtConfigFile) Then
            ConfigOptions.UserConfigText = File.ReadAllText(Request.TxtConfigFile)
        ElseIf Request.AddTxtConfigFromDatabase Then
            If IsoTools.IsConfigAvailable(Request.DetectedGameID, ConfigsDirectory + "\configs_txt.dat") Then
                ConfigOptions.DatabaseConfigText = IsoTools.GetPNACHFromDAT(ConfigsDirectory + "\configs_txt.dat", Request.DetectedGameID)
            End If
        End If

        'Write config-emu-ps4.txt
        File.WriteAllText(GameCacheDirectory + "\config-emu-ps4.txt", EmulatorConfigs.BuildPS2(ConfigOptions))

        Directory.CreateDirectory(GameCacheDirectory + "\feature_data\" + FullPS2GameID)

        'Check for PS2 Memory Card file
        If Not String.IsNullOrEmpty(Request.MemoryCardFile) Then
            File.Copy(Request.MemoryCardFile, GameCacheDirectory + "\feature_data\" + FullPS2GameID + "\custom.card", True)
        End If

        Directory.CreateDirectory(GameCacheDirectory + "\image")

        'Create a GP4 project and add the disc information
        BuilderHelpers.GenerateGp4(GameCacheDirectory, Gp4File)
        Dim Gp4Entries As New List(Of Gp4FileEntry)
        For Each Disc As KeyValuePair(Of Integer, String) In DiscFiles
            Gp4Entries.Add(New Gp4FileEntry("image/disc" + Disc.Key.ToString("00") + ".iso", Disc.Value, Request.UseCompression))
        Next
        Gp4Editor.PatchFile(Gp4File, Gp4Entries)

        'Create the fPKG
        Return BuilderHelpers.CreatePackage(Gp4File, PKGOutputFolder)
    End Function

End Class

#End Region

#Region "PSP"

Public Class PSPBuildRequest
    Public Property Title As String = ""
    Public Property NPTitle As String = ""
    Public Property IsoFile As String = ""
    Public Property IconFile As String = ""
    Public Property BackgroundFile As String = ""
    Public Property ConfigFile As String = ""
    ''' <summary>Called with a warning when the build continues with a problem (for example an EBOOT that could not be decrypted).</summary>
    Public Property Warn As Action(Of String)
End Class

Public Class PSPPackageBuilder

    Public Shared Function Build(Request As PSPBuildRequest, PKGOutputFolder As String) As PackageBuildResult
        Dim CacheDirectory As String = AppPaths.CacheDirectory
        Dim GameCacheDirectory As String = CacheDirectory + "\PSPfPKG"
        Dim Gp4File As String = CacheDirectory + "\PSPfPKG.gp4"
        Dim TempEbootFile As String = CacheDirectory + "\temp_eboot.bin"

        'Remove previous fPKG creation & re-create the PSPfPKG cache folder
        PkgTools.PrepareCacheDirectory(GameCacheDirectory, Gp4File)

        'Copy the PSP emulator to the cache directory
        FileUtils.CopyDirectory(AppPaths.ToolsDirectory + "\PS4\emus\psphd", GameCacheDirectory, True)
        Directory.CreateDirectory(GameCacheDirectory + "\data")

        'Copy the ISO as the user image and replace its encrypted EBOOT by the decrypted one
        File.Copy(Request.IsoFile, GameCacheDirectory + "\data\USER_L0.IMG", True)
        If String.IsNullOrEmpty(IsoTools.ExtractFileFromPSPISO(Request.IsoFile, "\PSP_GAME\SYSDIR\EBOOT.BIN", TempEbootFile)) Then
            Warn(Request, "Cannot read the EBOOT.BIN file from the ISO." + vbCrLf + "Warning: This game may not work!")
        Else
            ProcessRunner.Run(AppPaths.ToolsDirectory + "\pspdecrypt.exe", """" + TempEbootFile + """")

            If Not File.Exists(TempEbootFile + ".dec") OrElse Not PspTools.ReplaceEbootInImage(GameCacheDirectory + "\data\USER_L0.IMG", TempEbootFile, TempEbootFile + ".dec") Then
                Warn(Request, "Cannot decrypt the EBOOT.BIN file of the ISO." + vbCrLf + "Warning: This game may not work!")
            End If
        End If

        'Remove temp files
        If File.Exists(TempEbootFile) Then File.Delete(TempEbootFile)
        If File.Exists(TempEbootFile + ".dec") Then File.Delete(TempEbootFile + ".dec")
        If File.Exists(GameCacheDirectory + "\sce_sys\icon0.png") Then File.Delete(GameCacheDirectory + "\sce_sys\icon0.png")
        If File.Exists(GameCacheDirectory + "\sce_sys\pic1.png") Then File.Delete(GameCacheDirectory + "\sce_sys\pic1.png")

        'Copy the selected icon and background to the cache directory
        BuilderHelpers.AddIconAndBackground(GameCacheDirectory, Request.IconFile, Request.BackgroundFile)

        'PSP Emulator configuration
        Dim UserConfigText As String = Nothing
        If Not String.IsNullOrEmpty(Request.ConfigFile) Then
            UserConfigText = File.ReadAllText(Request.ConfigFile)
        End If
        File.WriteAllText(GameCacheDirectory + "\config-title.txt", EmulatorConfigs.BuildPSP(UserConfigText))

        'Create a new PARAM.SFO file
        File.WriteAllBytes(GameCacheDirectory + "\sce_sys\param.sfo", SfoBuilder.Build(SfoBuilder.PSPContentID(Request.NPTitle), Request.Title, Request.NPTitle))

        'Create a GP4 project
        BuilderHelpers.GenerateGp4(GameCacheDirectory, Gp4File)
        Gp4Editor.PatchFile(Gp4File)

        'Create the fPKG
        Return BuilderHelpers.CreatePackage(Gp4File, PKGOutputFolder)
    End Function

    Private Shared Sub Warn(Request As PSPBuildRequest, Message As String)
        If Request.Warn IsNot Nothing Then Request.Warn.Invoke(Message)
    End Sub

End Class

#End Region
