<ui:FluentWindow x:Class="BuildResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Build result - PS Classics fPKG Builder" Width="760" Height="600" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Build result" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon x:Name="ResultIcon" FontSize="32" Margin="0,0,12,0" />
                <TextBlock x:Name="ResultTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock x:Name="SuggestionText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#FFC857" />
            <TextBlock x:Name="PackageText" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="24,0,24,12" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" x:Name="DetailsHeader" Text="Details" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:TextBox x:Name="DetailsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" />
        </DockPanel>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="24,0,24,20">
            <ui:Button x:Name="FixButton" Content="Fix" Icon="{ui:SymbolIcon Wrench24}" Appearance="Primary" Visibility="Collapsed" Margin="0,0,8,8" />
            <ui:Button x:Name="CopyButton" Content="Copy" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,8" />
            <ui:Button x:Name="FullCheckButton" Content="Full check" Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,8,8"
                       ToolTip="Runs the SDK checker on the package (can take minutes on large games)" />
            <ui:Button x:Name="InstallGuideButton" Content="How to install" Icon="{ui:SymbolIcon Book24}" Margin="0,0,8,8" />
            <ui:Button x:Name="OpenFolderButton" Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,8" />
            <ui:Button x:Name="CloseButton" Content="Close" Appearance="Primary" IsDefault="True" Margin="0,0,0,8" />
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
