<ui:FluentWindow x:Class="GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Guide - PS Classics fPKG Builder" Width="760" Height="720" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Bullet" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="8,0,0,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Guide" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,28,28">
            <StackPanel>
                <TextBlock Text="How to create a fPKG" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                           Text="Pick a platform on the left, fill the fields and press Build fPKG. Every field has a help button (i) that explains it." />

                <TextBlock Text="1. Quick start" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Bullet}" Text="• Select Disc 1 (the BIN file for PS1, the ISO for PS2 and PSP). The game ID and the title are filled in when the game is recognized." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Check the NP Title: it must have exactly 9 characters, without _ or -." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Optional: choose an icon and a background." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Press Build fPKG and choose the output folder. The package is created there." />

                <TextBlock Text="2. Required and optional fields" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}" Text="Fields marked Required must be filled, or the build stops with a message. Fields marked Optional can be left empty." />
                <TextBlock Style="{StaticResource Bullet}" Text="• PS1: Disc 1, Title, NP Title. Optional: icon, background, discs 2 to 4, emulator options, TXT and LUA configs." />
                <TextBlock Style="{StaticResource Bullet}" Text="• PS2: Disc 1, Title, NP Title. Optional: icon, background, discs 2 to 5, emulator options, database configs, your own TXT or LUA config, memory card." />
                <TextBlock Style="{StaticResource Bullet}" Text="• PSP: ISO file, Title, NP Title. Optional: icon, background, custom config." />

                <TextBlock Text="3. Images (icon and background)" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}" Text="You do not need to convert images first. The app accepts PNG, JPG, BMP, GIF and WebP and converts them to PNG:" />
                <TextBlock Style="{StaticResource Bullet}" Text="• Icon: 512×512 pixels. A square image avoids distortion." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Background: 1920×1080 pixels. A 16:9 image avoids distortion." />
                <TextBlock Style="{StaticResource Bullet}" Text="• The preview on the right shows what the home screen will look like and warns when an image will be stretched or enlarged. For animated GIFs only the first frame is used." />

                <TextBlock Text="4. Emulators" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Bullet}" Text="• PS1: the emulator is fixed (ps1hd). The options only change how it runs." />
                <TextBlock Style="{StaticResource Bullet}" Text="• PS2: choose between Jak v2 (the default) and Rogue v1. If a game does not start or crashes, try the other one." />
                <TextBlock Style="{StaticResource Bullet}" Text="• PSP: the emulator is fixed (psphd)." />
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="The options under the emulator (upscaling, uprender, display mode, fixes) are optional. Start with the defaults; change one option at a time if a game has problems." />

                <TextBlock Text="5. Helpers that save time" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Bullet}" Text="• Drag and drop: drop the game (.bin, .cue or .iso), images, configs or a .pkg anywhere on the window. A .zip or .7z is opened by itself: the game files inside are found. The app puts each file in the right field." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Queue: the Queue button builds several games from .zip or .7z files, one after the other, with no questions. Choose the output folder and a preset, then press Start." />
                <TextBlock Style="{StaticResource Bullet}" Text="• PSP games in .cso (compressed) are accepted: the app converts them to .iso by itself." />
                <TextBlock Style="{StaticResource Bullet}" Text="• When something goes wrong, the message can have a Fix button (select the game again, show the Tools folder, clear the images...) that does it for you." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Find cover (PS1 and PS2): downloads the cover of the game by its ID and creates the icon and the background. PSP: 'Images from the disc' uses the icon and background stored on the disc." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Presets: in the Emulator section, choose Recommended, Most compatible or Best looking instead of changing each option." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Step-by-step mode (Settings): shows one step at a time with Next and Back buttons." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Before building, the app checks the files, the NP title and the free disk space, and tells you how to fix each problem." />
                <TextBlock Style="{StaticResource Bullet}" Text="• After building, the package is checked automatically and the History keeps the options you used, so you can compare what works." />

                <TextBlock x:Name="InstallSection" Text="6. Install the package on the console" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}" Text="Fake packages only install on a console with homebrew enabled (a jailbroken PS4 or PS5). The app cannot do that part for you." />
                <TextBlock Style="{StaticResource Bullet}" Text="1. Copy the .pkg file to the root folder of a USB drive formatted as exFAT (FAT32 also works for packages smaller than 4 GB)." />
                <TextBlock Style="{StaticResource Bullet}" Text="2. PS4 with GoldHEN: plug in the drive, open Settings › Debug Settings › Game › Package Installer, choose the package and install it." />
                <TextBlock Style="{StaticResource Bullet}" Text="3. PS5 with etaHEN: install the package from the USB drive with the package installer of your homebrew (for example the etaHEN debug settings or ItemzFlow)." />
                <TextBlock Style="{StaticResource Bullet}" Text="4. The game appears on the home screen with the icon you chose. If it does not start, write what happened in the History and try another emulator preset." />
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="You can also send the package over the network with a remote package installer; see the documentation of your homebrew." />

                <TextBlock Text="7. Wine (Linux and macOS)" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}" Text="The PS4 publishing tools are Windows programs: on Linux and macOS the app runs them through Wine. Install Wine and winetricks once, then press 'Wine setup' in the app: it prepares a Wine folder for the app and installs the Visual C++ 2008 runtime the tools need. The status at the bottom left tells you when everything is ready." />

                <TextBlock Text="8. Problems?" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Bullet}" Text="• A yellow warning under the preview is about an image, not an error: it is only a suggestion." />
                <TextBlock Style="{StaticResource Bullet}" Text="• If the app says the Tools folder is missing, keep the Tools folder next to the program (see the README)." />
                <TextBlock Style="{StaticResource Bullet}" Text="• Use 'Check a .pkg' to verify a package you created." />
                <TextBlock Style="{StaticResource Bullet}" Text="• If a game does not work on the console, note the emulator and the options you used and try changing one option at a time." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
