<ui:FluentWindow x:Class="PSClassicsfPKGBuilder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PS_Classics_fPKG_Builder"
        mc:Ignorable="d"
        Title="PS Classics fPKG Builder" Width="1320" Height="860" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- A form row: label on the left, browse button on the right, text box filling the rest -->
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="130" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Content" Value="Browse…" />
        </Style>
        <Style x:Key="Section" TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="OptionsWrap" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,24,8" />
            <Setter Property="MinWidth" Value="220" />
        </Style>
        <Style x:Key="ModeToggle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="WarningText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="#FFC857" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="PS Classics fPKG Builder" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <DockPanel Grid.Column="0" Margin="12,8,8,16" LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="ToolsStatusIcon" Symbol="CheckmarkCircle24" Margin="0,0,6,0" />
                        <TextBlock x:Name="ToolsStatusText" Text="Tools folder found" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Original project by SvenGDK" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ListBox x:Name="PlatformListBox" SelectedIndex="0" Background="Transparent" BorderThickness="0">
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Games24" Margin="0,0,10,0" />
                            <TextBlock Text="PS1 Classics" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Games24" Margin="0,0,10,0" />
                            <TextBlock Text="PS2 Classics" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Games24" Margin="0,0,10,0" />
                            <TextBlock Text="PSP Classics" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- ============================== PS1 ============================== -->
            <Grid x:Name="PS1Page" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="460" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="16,8,16,24">
                    <StackPanel>
                        <TextBlock Text="PlayStation 1" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Create a fake package from a .BIN game with its .CUE sheet (up to 4 discs). The game ID and title are detected from disc 1." Style="{StaticResource PageSubtitle}" />

                        <ui:CardExpander Header="Game" Icon="{ui:SymbolIcon Games24}" IsExpanded="True" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Disc 1" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS1Disc1Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="PS1SelectedDisc1TextBox" PlaceholderText="Select the .BIN file of the game" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="PS1TitleTextBox" PlaceholderText="Name shown on the home screen" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="NP Title" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="PS1NPTitleTextBox" PlaceholderText="9 characters, for example SLUS00594" MaxLength="9" CharacterCasing="Upper" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Icon &amp; background" Icon="{ui:SymbolIcon Image24}" IsExpanded="True" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS1IconButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPS1IconTextBox" PlaceholderText="PNG, ideally 512×512 (optional)" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="Background" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS1StartupImageButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPS1BGTextBox" PlaceholderText="PNG, ideally 1920×1080 (optional)" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Additional discs" Icon="{ui:SymbolIcon Album24}" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Disc 2" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS1Disc2Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="PS1SelectedDisc2TextBox" PlaceholderText="Optional .BIN file" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Disc 3" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS1Disc3Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="PS1SelectedDisc3TextBox" PlaceholderText="Optional .BIN file" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="Disc 4" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS1Disc4Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="PS1SelectedDisc4TextBox" PlaceholderText="Optional .BIN file" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Emulator" Icon="{ui:SymbolIcon Settings24}" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Upscaling" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PS1UpscalingComboBox" SelectedIndex="2" Width="140" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="6" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="1" />
                                    </ComboBox>
                                </DockPanel>
                                <WrapPanel Style="{StaticResource OptionsWrap}">
                                    <CheckBox x:Name="PS1SkipBootlogoCheckBox" Content="Skip boot logo" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS1EmulateAnalogSticksCheckBox" Content="Emulate analog sticks" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS1Force60HzCheckBox" Content="Force 60 Hz" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS1GunconCheckBox" Content="GunCon" Style="{StaticResource Option}" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Advanced configuration" Icon="{ui:SymbolIcon Code24}" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="TXT config" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS1TXTConfigButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPS1TXTConfigTextBox" PlaceholderText="Extra emulator options appended to config-title.txt" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="LUA config" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS1LUAConfigButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPS1LUAConfigTextBox" PlaceholderText="Game specific LUA script" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ScrollViewer>

                <ui:Card Grid.Column="1" Margin="0,8,24,24" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <DockPanel Margin="0" LastChildFill="True">
                        <ui:Button x:Name="BuildPS1fPKGButton" DockPanel.Dock="Bottom" Appearance="Primary" Content="Build fPKG" Icon="{ui:SymbolIcon Box24}" HorizontalAlignment="Stretch" Height="46" FontSize="16" Margin="0,16,0,0" />
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton x:Name="PS1PS4Radio" GroupName="PS1Mode" Content="PS4" IsChecked="True" Style="{StaticResource ModeToggle}" />
                                    <RadioButton x:Name="PS1PS5Radio" GroupName="PS1Mode" Content="PS5" Style="{StaticResource ModeToggle}" />
                                </StackPanel>
                                <TextBlock Text="Home screen preview" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <local:DashPreview x:Name="PS1Preview"
                                               IconPath="{Binding Text, ElementName=SelectedPS1IconTextBox}"
                                               BackgroundPath="{Binding Text, ElementName=SelectedPS1BGTextBox}"
                                               GameTitle="{Binding Text, ElementName=PS1TitleTextBox}"
                                               IsPS5="{Binding IsChecked, ElementName=PS1PS5Radio}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Width="120" Height="120" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True">
                                        <Image Source="{Binding CurrentIcon, ElementName=PS1Preview}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="icon0.png · 512×512" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Width="213" Height="120" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True">
                                        <Image Source="{Binding CurrentBackground, ElementName=PS1Preview}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="Background · 1920×1080" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Hints, ElementName=PS1Preview}" Style="{StaticResource WarningText}" />
                            <TextBlock Style="{StaticResource HintText}" Text="Approximation of the console home screen. Without an icon, the default icon of the emulator is used. Images are resized to 512×512 (icon) and 1920×1080 (background)." />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>
            </Grid>

            <!-- ============================== PS2 ============================== -->
            <Grid x:Name="PS2Page" Grid.Column="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="460" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="16,8,16,24">
                    <StackPanel>
                        <TextBlock Text="PlayStation 2" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Create a fake package from an .ISO game (up to 5 discs). Game ID, title and the available configs are detected from disc 1." Style="{StaticResource PageSubtitle}" />

                        <ui:CardExpander Header="Game" Icon="{ui:SymbolIcon Games24}" IsExpanded="True" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Disc 1" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2Disc1Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedDisc1TextBox" PlaceholderText="Select the .ISO file of the game" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="PS2TitleTextBox" PlaceholderText="Name shown on the home screen" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="NP Title" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="PS2NPTitleTextBox" PlaceholderText="9 characters, for example SLUS21258" MaxLength="9" CharacterCasing="Upper" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Icon &amp; background" Icon="{ui:SymbolIcon Image24}" IsExpanded="True" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2IconButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedIconTextBox" PlaceholderText="PNG, ideally 512×512 (optional)" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="Background" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2StartupImageButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedStartupImageTextBox" PlaceholderText="PNG, ideally 1920×1080 (optional)" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Additional discs" Icon="{ui:SymbolIcon Album24}" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Disc 2" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2Disc2Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedDisc2TextBox" PlaceholderText="Optional .ISO file" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Disc 3" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2Disc3Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedDisc3TextBox" PlaceholderText="Optional .ISO file" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Disc 4" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2Disc4Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedDisc4TextBox" PlaceholderText="Optional .ISO file" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Disc 5" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2Disc5Button" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedDisc5TextBox" PlaceholderText="Optional .ISO file" />
                                </DockPanel>
                                <CheckBox x:Name="PS2RestartEmulatorOnDiscChangeCheckBox" Content="Restart the emulator when the disc changes" IsChecked="False" />
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Emulator" Icon="{ui:SymbolIcon Settings24}" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Emulator" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PS2EmulatorComboBox" SelectedIndex="0" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Jak v2" />
                                        <ComboBoxItem Content="Rogue v1" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Upscaling" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PS2UpscalingComboBox" SelectedIndex="0" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="None" />
                                        <ComboBoxItem Content="GPU" />
                                        <ComboBoxItem Content="Bilinear" />
                                        <ComboBoxItem Content="Edgesmooth" />
                                        <ComboBoxItem Content="Point" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Uprender" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PS2UprenderComboBox" SelectedIndex="1" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="None" />
                                        <ComboBoxItem Content="2x2" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Display mode" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PS2DisplayModeComboBox" SelectedIndex="0" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Normal" />
                                        <ComboBoxItem Content="Full" />
                                        <ComboBoxItem Content="4:3" />
                                        <ComboBoxItem Content="16:9" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Multitap" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PS2MultitapComboBox" SelectedIndex="0" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Disabled" />
                                        <ComboBoxItem Content="On Port 1" />
                                        <ComboBoxItem Content="On Port 2" />
                                        <ComboBoxItem Content="On Port 1 and 2" />
                                    </ComboBox>
                                </DockPanel>
                                <WrapPanel Style="{StaticResource OptionsWrap}">
                                    <CheckBox x:Name="PS2FixGraphicsCheckBox" Content="Fix graphics" IsChecked="True" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS2ImproveSpeedCheckBox" Content="Improve speed" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS2DisableMTVUCheckBox" Content="Disable MTVU" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS2DisableInstantVIF1TransferCheckBox" Content="Disable instant VIF1 transfer" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS2UseWidescreenPatchCheckBox" Content="Widescreen patch" IsEnabled="False" Style="{StaticResource Option}" ToolTip="Available when the game database has a widescreen patch for the selected game" />
                                    <CheckBox x:Name="PS2UseCompressionCheckBox" Content="Compress the discs in the package" IsChecked="True" Style="{StaticResource Option}" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Configs &amp; memory card" Icon="{ui:SymbolIcon Code24}" Style="{StaticResource Section}">
                            <StackPanel>
                                <WrapPanel Style="{StaticResource OptionsWrap}">
                                    <CheckBox x:Name="PS2AddTXTConfigFromDatabaseCheckBox" Content="TXT config from database" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS2AddLUAConfigFromDatabaseCheckBox" Content="LUA config from database" Style="{StaticResource Option}" />
                                    <CheckBox x:Name="PS2AddPS3ConfigFromDatabaseCheckBox" Content="PS3 config from database" Style="{StaticResource Option}" />
                                </WrapPanel>
                                <DockPanel>
                                    <TextBlock Text="TXT config" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2TXTConfigButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPS2TXTConfigTextBox" PlaceholderText="Your own config (replaces the database config)" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="LUA config" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2LUAConfigButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPS2LUAConfigTextBox" PlaceholderText="Your own LUA script (replaces the database script)" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="Memory card" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePS2MCButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPS2MemoryCardTextBox" PlaceholderText="Import an 8 MB PS2 memory card (.vm2, .ps2, .bin)" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ScrollViewer>

                <ui:Card Grid.Column="1" Margin="0,8,24,24" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <DockPanel Margin="0" LastChildFill="True">
                        <ui:Button x:Name="BuildPS2fPKGButton" DockPanel.Dock="Bottom" Appearance="Primary" Content="Build fPKG" Icon="{ui:SymbolIcon Box24}" HorizontalAlignment="Stretch" Height="46" FontSize="16" Margin="0,16,0,0" />
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton x:Name="PS2PS4Radio" GroupName="PS2Mode" Content="PS4" IsChecked="True" Style="{StaticResource ModeToggle}" />
                                    <RadioButton x:Name="PS2PS5Radio" GroupName="PS2Mode" Content="PS5" Style="{StaticResource ModeToggle}" />
                                </StackPanel>
                                <TextBlock Text="Home screen preview" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <local:DashPreview x:Name="PS2Preview"
                                               IconPath="{Binding Text, ElementName=SelectedIconTextBox}"
                                               BackgroundPath="{Binding Text, ElementName=SelectedStartupImageTextBox}"
                                               GameTitle="{Binding Text, ElementName=PS2TitleTextBox}"
                                               IsPS5="{Binding IsChecked, ElementName=PS2PS5Radio}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Width="120" Height="120" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True">
                                        <Image Source="{Binding CurrentIcon, ElementName=PS2Preview}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="icon0.png · 512×512" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Width="213" Height="120" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True">
                                        <Image Source="{Binding CurrentBackground, ElementName=PS2Preview}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="Background · 1920×1080" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Hints, ElementName=PS2Preview}" Style="{StaticResource WarningText}" />
                            <TextBlock Style="{StaticResource HintText}" Text="Approximation of the console home screen. Without an icon, the default icon of the selected emulator is used. Images are resized to 512×512 (icon) and 1920×1080 (background)." />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>
            </Grid>

            <!-- ============================== PSP ============================== -->
            <Grid x:Name="PSPPage" Grid.Column="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="460" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="16,8,16,24">
                    <StackPanel>
                        <TextBlock Text="PlayStation Portable" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Create a fake package from a PSP .ISO game. The NP title is read from the disc and the title from the file name." Style="{StaticResource PageSubtitle}" />

                        <ui:CardExpander Header="Game" Icon="{ui:SymbolIcon Games24}" IsExpanded="True" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="ISO file" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePSPDiscButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPSPDiscTextBox" PlaceholderText="Select the .ISO file of the game" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="PSPTitleTextBox" PlaceholderText="Name shown on the home screen" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="NP Title" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="PSPNPTitleTextBox" PlaceholderText="9 characters, for example ULUS10041" MaxLength="9" CharacterCasing="Upper" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Icon &amp; background" Icon="{ui:SymbolIcon Image24}" IsExpanded="True" Style="{StaticResource Section}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePSPIconButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPSPIconTextBox" PlaceholderText="PNG, ideally 512×512 (recommended)" />
                                </DockPanel>
                                <DockPanel Margin="0">
                                    <TextBlock Text="Background" Style="{StaticResource FieldLabel}" />
                                    <Button x:Name="BrowsePSPBGButton" Style="{StaticResource BrowseButton}" />
                                    <ui:TextBox x:Name="SelectedPSPBGImageTextBox" PlaceholderText="PNG, ideally 1920×1080 (optional)" />
                                </DockPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:CardExpander Header="Advanced configuration" Icon="{ui:SymbolIcon Code24}" Style="{StaticResource Section}">
                            <DockPanel Margin="0">
                                <TextBlock Text="Custom config" Style="{StaticResource FieldLabel}" />
                                <Button x:Name="BrowsePSPConfigButton" Style="{StaticResource BrowseButton}" />
                                <ui:TextBox x:Name="SelectedPSPConfigTextBox" PlaceholderText="config-title.txt options appended to the default config" />
                            </DockPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ScrollViewer>

                <ui:Card Grid.Column="1" Margin="0,8,24,24" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <DockPanel Margin="0" LastChildFill="True">
                        <ui:Button x:Name="BuildPSPfPKGButton" DockPanel.Dock="Bottom" Appearance="Primary" Content="Build fPKG" Icon="{ui:SymbolIcon Box24}" HorizontalAlignment="Stretch" Height="46" FontSize="16" Margin="0,16,0,0" />
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton x:Name="PSPPS4Radio" GroupName="PSPMode" Content="PS4" IsChecked="True" Style="{StaticResource ModeToggle}" />
                                    <RadioButton x:Name="PSPPS5Radio" GroupName="PSPMode" Content="PS5" Style="{StaticResource ModeToggle}" />
                                </StackPanel>
                                <TextBlock Text="Home screen preview" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <local:DashPreview x:Name="PSPPreview"
                                               IconPath="{Binding Text, ElementName=SelectedPSPIconTextBox}"
                                               BackgroundPath="{Binding Text, ElementName=SelectedPSPBGImageTextBox}"
                                               GameTitle="{Binding Text, ElementName=PSPTitleTextBox}"
                                               IsPS5="{Binding IsChecked, ElementName=PSPPS5Radio}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Width="120" Height="120" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True">
                                        <Image Source="{Binding CurrentIcon, ElementName=PSPPreview}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="icon0.png · 512×512" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Border Width="213" Height="120" CornerRadius="6" Background="#22FFFFFF" ClipToBounds="True">
                                        <Image Source="{Binding CurrentBackground, ElementName=PSPPreview}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="Background · 1920×1080" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Hints, ElementName=PSPPreview}" Style="{StaticResource WarningText}" />
                            <TextBlock Style="{StaticResource HintText}" Text="Approximation of the console home screen. PSP packages have no default icon, so choosing one is recommended. Images are resized to 512×512 (icon) and 1920×1080 (background)." />
                        </StackPanel>
                    </DockPanel>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
